# TRI RECURSION PROBLEMS 
def tri_recursion(k):
    if (k>0):
        result= k + tri_recursion(k-1)
        print(result)
    else:
        result=0
    return(result)
tri_recursion(6)


def tri_recursion(k):
  if(k > 0):
    result = k + tri_recursion(k - 1)
    print(result)
  else:
    result = 0
  return result

print("Recursion Example Results:")
tri_recursion(6)
