# FUNCTION THROUGH *ARGS & **KWARGS
def employee(name, salary,*idn, **numbers):
    print(f"Name:{name}, salary:{salary}")
    if idn:
        print("Additional info:",idn)
    if numbers:
        print("Personal info:",numbers)
employee('janardhan','250000','25','35','52',cn=9848762199,en=7894847100)


