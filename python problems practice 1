#changing the case of the string without inbuilt functions

sentence=input()
words=sentence.split()

converted_words=[]
for i in words:
    if len(i)>0:
        new_word=i[0].upper()+i[1:].lower()
        converted_words.append(new_word)
    else:
        converted_words.append(i)

result=''.join(converted_words)
print(result)

#counting the frequency of the distinct characters

def char_frequency(s):

    frequency={}

    for i in s:
        if i in frequency:
            frequency[i]+=1
        else:
            frequency[i]=1
    sorted_freq=dict(sorted(frequency.items()))
    
    return frequency

