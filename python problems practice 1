#STAR PYRAMID PATTERN PRINTING (SYMMETRICAL)

def star_pyramid(n):
    for i in range(1,n+1):
        print(" "*(n-i),end="")

        print("*"*(2*i-1))

n=int(input())
star_pyramid(n)

# NUMBER PYRAMID (SYMMETRICAL)

def number_pyramid(n):

    for i in range(1,n+1):
        print(" "*(n-i),end="")

        for j in range(1,i+1):
            print(j,end="")
        for j in range(i-1,0,-1):
            print(j,end="")
        print()
n=int(input())
number_pyramid(n)

#INVERTED STAR PATTERN (SYMMETRICAL)

def inverted_star_pyramid(n):
    for i in range(n,0,-1):
        print(" "*(n-i),end="")

        print("*"*(2*i-1))

