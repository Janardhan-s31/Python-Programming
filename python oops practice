#PARENT CLASS AND CHILD CLASS 

class Employee:
    def __init__(self,name,emp_id,basic_salary):
        self.name=name
        self.emp_id=emp_id
        self.basic_salary=basic_salary

    def display(self):
        print(f"Employee Name={self.name}")
        print(f"EmployeeID= {self.emp_id}")
        print(f"Basic Salary= ${self.basic_salary:.2f}")
class FullTimeEmployee(Employee):
    def __init__(self,name,emp_id,basic_salary,hra,da,bonus):
        super().__init__(name,emp_id,basic_salary)
        self.hra=hra
        self.da=da
        self.bonus=bonus

    def net_salary(self):
        net_salary=self.basic_salary+self.hra+self.da+self.bonus
        return self.net_salary

    def display(self):
        print(f"Employee Name={self.name}")
        print(f"EmployeeID= {self.emp_id}")
        print(f"Basic Salary= ${self.basic_salary:.2f}")
        print(f"HRA= ${self.hra:.2f}")
        print(f"DA= ${self.da:.2f}")
        print(f"Bonus= ${self.bonus:.2f}")
        
        net_salary=self.basic_salary+self.hra+self.da+self.bonus
        print(f"Net Salary= ${net_salary:.2f}")


